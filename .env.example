# ==========================================
# Crowd Monitoring Prototype - Environment Configuration
# ==========================================

# Roboflow Dataset API Key (Phase 1)
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# ------------------------------------------
# PostgreSQL Database Configuration (Phase 3)
# ------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crowd_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
# Optional full connection URL (overrides individual variables if provided):
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/crowd_monitoring

# ------------------------------------------
# SMTP Email Alert Configuration (Phase 3)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_SENDER=your_email@gmail.com
# For Gmail, use a 16-character Google App Password (not your primary password)
SMTP_PASSWORD=your_smtp_app_password_here
# Comma-separated list of recipient email addresses
ALERT_RECIPIENTS=admin@example.com,security@example.com
# Set to true to enable sending live emails via SMTP (keep false during testing/dev)
SMTP_ENABLED=false

# ------------------------------------------
# Monitoring & Incident Settings
# ------------------------------------------
MONITORING_LOCATION="Main Surveillance Hub"
INCIDENT_SNAPSHOT_DIR=runs/incidents
DEFAULT_SUSTAINED_SECONDS=3.0

